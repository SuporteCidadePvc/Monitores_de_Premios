<?php

namespace App\Domain\Announcements;

use InvalidArgumentException;

final readonly class AnnouncementAttachment
{
    /** Phase 1 accepts raster images only; SVG is excluded because it can carry scripts. */
    public const IMAGE_MIME_TYPES = ['image/jpeg', 'image/png', 'image/webp'];

    public function __construct(
        public int $id,
        public string $storedName,
        public string $originalName,
        public string $mimeType,
        public int $sizeBytes,
        public string $sha256,
        public ?int $width,
        public ?int $height,
    ) {
        if ($id < 1) {
            throw new InvalidArgumentException('An announcement attachment must have an identifier.');
        }

        if ($storedName === ''
            || strlen($storedName) > 64
            || preg_match('/[\/\\\\:]/', $storedName) === 1
            || str_contains($storedName, '..')) {
            throw new InvalidArgumentException('The stored attachment name is invalid.');
        }

        if (trim($originalName) === '' || mb_strlen($originalName) > 255) {
            throw new InvalidArgumentException('The original attachment name must contain between 1 and 255 characters.');
        }

        if (! in_array($mimeType, self::IMAGE_MIME_TYPES, true)) {
            throw new InvalidArgumentException('The attachment type is not supported.');
        }

        if ($sizeBytes < 1) {
            throw new InvalidArgumentException('The attachment size must be greater than zero.');
        }

        if (preg_match('/^[0-9a-f]{64}$/i', $sha256) !== 1) {
            throw new InvalidArgumentException('The attachment hash must be a SHA-256 hexadecimal value.');
        }

        if (($width === null) !== ($height === null)
            || ($width !== null && ($width < 1 || $height < 1))) {
            throw new InvalidArgumentException('The attachment dimensions must both be positive or both be absent.');
        }
    }

    public function isImage(): bool
    {
        return in_array($this->mimeType, self::IMAGE_MIME_TYPES, true);
    }
}
